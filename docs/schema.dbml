Table customer {
  customer_id bigserial [pk]
  phone varchar(20) [unique, not null]
  full_name varchar(120) [not null]
  address varchar(255)
  is_active boolean [not null]
}

Table device {
  device_id bigserial [pk]
  customer_id bigint [not null]
  serial_no varchar(50) [unique, not null]
  is_external boolean [not null]
  origin_note varchar(200)
  purchase_date date
  warranty_months smallint [not null]
  is_active boolean [not null]
}

Table employee {
  employee_id bigserial [pk]
  full_name varchar(120) [not null]
  role varchar(20) [not null]
  center_code varchar(20) [not null]
}

Table issue_category {
  category_id serial [pk]
  category_name varchar(60) [unique, not null]
  default_priority varchar(10) [not null]
}

Table ticket {
  ticket_id bigserial [pk]
  ticket_code varchar(20) [unique, not null]
  customer_id bigint [not null]
  device_id bigint [not null]
  center_code varchar(20) [not null]
  created_by bigint [not null]
  issue_desc text [not null]
  priority varchar(10) [not null]
  status varchar(20) [not null]
  category_id int [not null]
  is_warranty boolean
  verified_by bigint
  verified_at timestamptz
  reject_reason varchar(300)
  received_at timestamptz [not null]
  due_date timestamptz [not null]

  indexes {
    (center_code, due_date)
    (device_id, status)
  }
}

Table ticket_status_log {
  log_id bigserial [pk]
  ticket_id bigint [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_by bigint [not null]
  changed_at timestamptz [not null]
  note varchar(255)

  indexes {
    (ticket_id, changed_at)
  }
}

Ref: device.customer_id > customer.customer_id
Ref: ticket.customer_id > customer.customer_id
Ref: ticket.device_id > device.device_id
Ref: ticket.category_id > issue_category.category_id
Ref: ticket.created_by > employee.employee_id
Ref: ticket.verified_by > employee.employee_id
Ref: ticket_status_log.ticket_id > ticket.ticket_id
Ref: ticket_status_log.changed_by > employee.employee_id