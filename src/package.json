{
  "name": "capstoneone",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "imports": {
    "#errors/*": "./src/errors/*",
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#prisma/*": "./src/prisma/*",
    "#repositories/*": "./src/repositories/*",
    "#services/*": "./src/services/*",
    "#validators/*": "./src/validators/*"
  },
  "scripts": {
    "db:seed": "tsx src/prisma/seed.run.ts",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "pnpm run build && pnpm run composer:deploy",
    "dev": "vite dev",
    "dev:composer": "pnpm run build && pnpm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "prisma": "8.0.0-rc.21",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "@tailwindcss/vite": "^4.3.3",
    "alchemy": "2.0.0-beta.78",
    "dotenv": "^18.0.7",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5"
  }
}
