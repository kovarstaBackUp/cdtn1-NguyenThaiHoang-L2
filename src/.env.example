# Connection string for PostgreSQL (required). Requires PostgreSQL >= 15.
#
# The value below matches the bundled Docker image in docker-compose.yaml:
# postgres:16-alpine on localhost:5432, user/password postgres/postgres,
# database capstoneone. If you already run your own PostgreSQL server, point
# this at it instead and create the database once — see the README.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/capstoneone"

# Optional. Only needed when your provider hands out a separate direct
# (non-pooled) connection for schema changes. Nothing in this project reads it
# today; it is here as a placeholder for a pooled production setup.
# DIRECT_URL="postgresql://user:password@host:5432/capstoneone"

# --- Dev-only identity -------------------------------------------------------
# Used by src/hooks.server.ts when a request carries no Authorization header,
# so the app is browsable without minting a token.
#
# Defaults: employee 1, role NHAN_VIEN, centre TT01.
#
# Role checks are currently off — see AUTHORIZATION_ENFORCED in
# src/services/access.ts — so any role can use every screen. Centre scoping
# still applies: the caller only sees tickets for the centre named here.
# DEV_EMPLOYEE_ID=1
# DEV_ROLE=NHAN_VIEN
# DEV_CENTER_CODE=TT01
